# TEZRA website — environment variables
# Copy to .env.local for development, and set the same keys in the host at deploy.

# Production origin, no trailing slash. Used for canonical URLs, social previews,
# robots.txt and sitemap.xml. The domain is still to be confirmed with TEZRA.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine visibility. "true" removes the noindex tag, opens robots.txt and
# publishes the sitemap, all at once. Production is live; keep it off locally.
NEXT_PUBLIC_SITE_LAUNCHED=false

# CMS database (Payload). Locally this is the Postgres container in
# docker-compose.yml, started with: docker compose up -d
# In production, point it at the managed Postgres instance.
DATABASE_URI=postgres://tezra:tezra_local_dev@localhost:5434/tezra

# Signs CMS login sessions. Generate a long random value, different per
# environment, and never commit it:  openssl rand -hex 32
PAYLOAD_SECRET=

# Contact-form delivery, through EmailJS. Enquiries go to
# business.development@tezragroup.com (confirmed by TEZRA).
#
# All three are public by design — EmailJS sends from the browser. The thing that
# protects the account is the domain allowlist in the EmailJS dashboard, so set
# that up alongside these keys or anyone can post through it.
#
# Until all three are present the form tells the visitor it could not send and
# shows the email address, rather than faking success.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Uploaded media. Unset locally, so uploads stay in public/uploads. Set all four in the
# host and Payload writes to the bucket instead — a container's disk is wiped on redeploy.
# Any S3-compatible bucket works: Railway's own, Cloudflare R2, Backblaze, AWS.
# The bucket stays private; Payload streams files through /api/media/file/ as it does now.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave unset for Railway, whose buckets are virtual-hosted. Set to "true" for Cloudflare R2.
S3_FORCE_PATH_STYLE=
